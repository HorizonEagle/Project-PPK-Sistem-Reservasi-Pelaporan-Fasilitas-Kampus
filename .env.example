# Database
DATABASE_URL=postgresql://campus_user:campus_password_123@localhost:5432/campus_facility

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# Wajib di production: backend menolak /api/metrics (503) bila kosong.
# Prometheus mengirimnya sebagai Bearer token (monitoring/prometheus.yml).
METRICS_TOKEN=dev-metrics-token-change-me

# Dipakai docker-compose untuk password PostgreSQL (default dev bila kosong)
POSTGRES_PASSWORD=campus_password_123

# App
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880
